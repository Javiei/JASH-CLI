  },
  "keywords": [
    "cli",
    "moodle",
    "ai",
    "asistente",
    "tareas",
    "openai",
    "claude",
    "gemini",
    "ollama"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "docx": "^9.12.0",
    "marked": "^18.1.1",
    "ora": "^9.4.1"
  }
}
