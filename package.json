{
  "name": "jash-cli",
  "version": "0.2.3",
  "description": "Jash: asistente de tareas escolares en la terminal. Se conecta a Moodle y a agentes de IA (OpenAI, Claude, Gemini, Ollama).",
  "type": "module",
  "bin": {
    "jash": "bin/jash.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/jash.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
